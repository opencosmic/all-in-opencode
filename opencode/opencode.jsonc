{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "open-design": {
      "type": "local",
      "command": [
        "/bin/sh",
        "-c",
        "exec \"$HOME/.config/opencode/open-design-mcp.sh\""
      ],
      "enabled": true
    },
    "blender": {
      "type": "local",
      "command": [
        "uvx",
        "--python",
        "3.11",
        "blender-mcp"
      ],
      "enabled": true,
      "environment": {
        "UV_PYTHON_PREFERENCE": "only-managed",
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876",
        "BLENDER_MCP_SAFE_MODE": "1",
        "DISABLE_TELEMETRY": "true"
      }
    }
  },
  "permission": {
    "open_design_*": "deny"
  },
  "provider": {
    "openrouter": {
      "whitelist": [
        "deepseek/deepseek-v4.1-flash",
        "z-ai/glm-5.3-flash"
      ]
    }
  }
}
