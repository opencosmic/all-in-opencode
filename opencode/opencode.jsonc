{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "open-design": {
      "type": "local",
      "command": [
        "/bin/sh",
        "-c",
        "exec \"$HOME/.config/opencode/open-design-mcp.sh\""
      ],
      "enabled": true
    }
  },
  "permission": {
    "open_design_*": "deny"
  }
}
